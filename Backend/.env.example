# ---- Runtime ----
PORT=5000
NODE_ENV=production          # must be "production" on the live server
TRUST_PROXY=1                # number of proxies in front of the app (0 if exposed directly)

# ---- Database ----
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>
# Must be a replica set — checkout uses multi-document transactions.

# ---- Auth ----
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this logs every user out. Minimum 32 chars; the app refuses to
# start in production with anything shorter.
JWT_SECRET=<96-hex-characters>
JWT_EXPIRES=7d

# ---- Frontend ----
CLIENT_URL=https://thesakhijewels.com
# Comma-separated browser origins allowed to call this API. Include both the
# apex and www forms, and the admin panel.
CORS_ORIGINS=https://thesakhijewels.com,https://www.thesakhijewels.com,https://adminsakhi.thesakhijewels.com

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
# Live keys start with rzp_live_. The app refuses to start in production with
# rzp_test_ keys.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Signing secret of the webhook you create at Dashboard > Settings > Webhooks
# (URL: https://<your-api-domain>/api/webhooks/razorpay, event: payment.captured).
# Without it the webhook is ignored, and an order is only placed when the
# customer's browser returns from Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# ---- OTP delivery ----
# How login OTPs are sent: "whatsapp", "2factor", or "console" (prints the OTP
# to the server log instead of sending it — dev only).
SMS_PROVIDER=whatsapp
# Optional: provider to try when the primary one errors while sending (outage,
# bad token, rejected template). It does NOT help customers who have no
# WhatsApp account — WhatsApp accepts those messages and reports the failure
# later. Leave empty to disable.
OTP_FALLBACK_PROVIDER=

# ---- WhatsApp Cloud API ----
# Permanent System User token with whatsapp_business_messaging. Never put it in
# a frontend .env — VITE_* values are bundled into public JavaScript.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1277455508789922
# Approved AUTHENTICATION template (copy-code button) and its language code.
WHATSAPP_TEMPLATE_NAME=sakhi_otp_template
WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_API_VERSION=v23.0

# ---- 2Factor.in ----
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=
